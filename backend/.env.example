# --- Développement local (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Production (Supabase PostgreSQL) ---
# Décommentez et utilisez ces deux lignes UNIQUEMENT avec backend/prisma/schema.production.prisma
# DATABASE_URL="postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Obligatoire en production (16 caractères minimum, le serveur refuse de démarrer sinon) : openssl rand -base64 32
JWT_SECRET="change_this_secret_in_production_please_use_a_long_random_string"
# Mot de passe du Super Admin pour le seed / npm run admin:password (12 caractères minimum)
# SUPERADMIN_PASSWORD=""
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
